<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Wyrmwatch.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter, Segoe UI" /><Setter Property="FontSize" Value="14" /><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
    <Style Selector="TextBlock.eyebrow"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="1.4" /></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.7" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="22" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7" /><Setter Property="Padding" Value="16,10" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#8A78F0" /><Setter Property="Foreground" Value="#111019" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#A596F7" /><Setter Property="Foreground" Value="#111019" /></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#8A78F0" /><Setter Property="Foreground" Value="#111019" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Opacity" Value="0.55" /></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="7" /><Setter Property="MinHeight" Value="38" /></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="7" /><Setter Property="MinHeight" Value="38" /></Style>
    <Style Selector="ListBox.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.nav ListBoxItem"><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,12" /><Setter Property="Margin" Value="0,3" /><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" /></Style>
    <Style Selector="ListBox.nav ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" /></Style>
    <Style Selector="ListBox.servers ListBoxItem"><Setter Property="CornerRadius" Value="9" /><Setter Property="Margin" Value="0,3" /></Style>
    <Style Selector="ListBox.servers ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" /></Style>
    <Style Selector="ListBox.servers ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource NavSelectedTextBrush}" /></Style>
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#302A4A" /><SolidColorBrush x:Key="NavSelectedTextBrush" Color="#CABEFF" /><SolidColorBrush x:Key="WorkspaceStatusBrush" Color="#89C6A9" />
          <SolidColorBrush x:Key="CanvasBrush" Color="#18191F" /><SolidColorBrush x:Key="SidebarBrush" Color="#121318" /><SolidColorBrush x:Key="CardBrush" Color="#202128" /><SolidColorBrush x:Key="LineBrush" Color="#32333D" /><SolidColorBrush x:Key="TextBrush" Color="#EEEFF4" /><SolidColorBrush x:Key="MutedBrush" Color="#9B9EAF" /><SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#292B35" /><SolidColorBrush x:Key="ButtonHoverBrush" Color="#353846" /><SolidColorBrush x:Key="ButtonPressedBrush" Color="#242630" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="NavSelectedBrush" Color="#DED8F5" /><SolidColorBrush x:Key="NavSelectedTextBrush" Color="#49358A" /><SolidColorBrush x:Key="WorkspaceStatusBrush" Color="#2D6A4F" />
          <SolidColorBrush x:Key="CanvasBrush" Color="#F3F4F8" /><SolidColorBrush x:Key="SidebarBrush" Color="#E9EBF2" /><SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" /><SolidColorBrush x:Key="LineBrush" Color="#D9DCE7" /><SolidColorBrush x:Key="TextBrush" Color="#202131" /><SolidColorBrush x:Key="MutedBrush" Color="#5F6377" /><SolidColorBrush x:Key="ButtonSurfaceBrush" Color="#F3F4F8" /><SolidColorBrush x:Key="ButtonHoverBrush" Color="#E7E9F1" /><SolidColorBrush x:Key="ButtonPressedBrush" Color="#DBDEEA" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

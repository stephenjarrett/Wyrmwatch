<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Wyrmwatch.Desktop" x:Class="Wyrmwatch.Desktop.MainWindow"
        Title="Wyrmwatch · Dragonwilds server manager" Width="1240" Height="850" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="224,*" Background="{DynamicResource CanvasBrush}">
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,28,16,20">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,30">
          <Border Background="#8A78F0" CornerRadius="11" Width="38" Height="38"><TextBlock Text="W" FontSize="22" FontWeight="Bold" Foreground="#181321" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Wyrmwatch" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="DRAGONWILDS" Classes="eyebrow" FontSize="9" /></StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{DynamicResource Ui.5493ff8e9397}" Classes="eyebrow" Margin="14,0,0,12" />
        <ListBox Grid.Row="2" x:Name="Navigation" Classes="nav" SelectedIndex="0" SelectionChanged="Navigate">
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="◈" Width="18" /><TextBlock Text="{DynamicResource Ui.68d7beb6df59}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="⚒" Width="18" /><TextBlock Text="{DynamicResource Ui.3e8fb11efc9e}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="⌁" Width="18" /><TextBlock Text="{DynamicResource Ui.e89b30aa1dc3}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="◷" Width="18" /><TextBlock Text="{DynamicResource Ui.d909750b1bbb}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="▣" Width="18" /><TextBlock Text="{DynamicResource Ui.3334fee2c77f}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="☷" Width="18" /><TextBlock Text="{DynamicResource Ui.38da1505ca83}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="⚙" Width="18" /><TextBlock Text="{DynamicResource Ui.74a883a037bc}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="?" Width="18" /><TextBlock Text="{DynamicResource Ui.b9ff3407124b}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="↓" Width="18" /><TextBlock Text="{DynamicResource Ui.5808deaecd58}" /></StackPanel></ListBoxItem>
        </ListBox>
        <StackPanel Grid.Row="3" Spacing="12" Margin="8,0">
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,4" />
          <TextBlock Text="{DynamicResource Ui.1f799d61952d}" Foreground="{DynamicResource WorkspaceStatusBrush}" FontSize="12" />
          <TextBlock Text="{DynamicResource Ui.64d923c20eab}" Classes="muted" FontSize="11" />
          <TextBlock Text="{DynamicResource Ui.46e84d8edad0}" Classes="muted" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="34,28,34,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="0,0,0,26">
        <TextBlock Text="{Binding PageTitle}" Classes="heading" TextWrapping="Wrap" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding ShowServerPicker}">
          <TextBlock Text="{DynamicResource Ui.aef7de28d529}" Classes="muted" FontSize="11" />
        <ComboBox Width="230" IsEnabled="{Binding CanManage}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=OneWay}" PlaceholderText="{DynamicResource Ui.5b428863326e}" SelectionChanged="ServerSelected">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
        <Border x:Name="OperationCard" Classes="card" Padding="16" IsVisible="{Binding OperationActive}">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{Binding OperationTitle}" FontWeight="SemiBold" /><Button Grid.Column="1" Content="{DynamicResource Ui.e268c297c037}" Click="GoActivity" Padding="10,4" /></Grid>
            <TextBlock Text="{Binding OperationServer}" Classes="muted" FontSize="12" />
            <ProgressBar IsIndeterminate="True" Height="4" />
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding OperationPhase}" /><TextBlock Grid.Column="1" Text="{Binding OperationElapsed}" Classes="muted" /></Grid>
            <TextBlock Text="{Binding OperationLatestActivity}" ToolTip.Tip="{Binding OperationLatestActivity}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxHeight="40" />
            <TextBlock Text="{Binding OperationLastUpdate}" Classes="muted" FontSize="11" />
          </StackPanel>
        </Border>
        <Border x:Name="OperationErrorCard" Classes="card attention" Padding="16" IsVisible="{Binding HasError}">
          <StackPanel Spacing="8"><TextBlock Text="{Binding ErrorSummary}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" TextWrapping="Wrap" /><Expander Header="Technical details"><TextBlock Text="{Binding ErrorDetail}" TextWrapping="Wrap" /></Expander><WrapPanel><Button x:Name="OperationErrorAction" Content="{Binding ErrorActionText}" Click="GoErrorDestination" Margin="0,0,8,0" /><Button Content="{DynamicResource Ui.e8722f00fcd5}" Classes="subtle" Click="DismissError" /></WrapPanel></StackPanel>
        </Border>
        <TextBlock Text="{Binding ServerStateHint}" Classes="muted" FontSize="12" IsVisible="{Binding HasServer}" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer x:Name="PageScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource CanvasBrush}" ClipToBounds="True">
        <Grid>
          <StackPanel x:Name="ServersPage" Spacing="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <TextBlock Text="{Binding ServerCount}" Classes="muted" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="ImportServerButton" Content="{DynamicResource Ui.6c597d997629}" Click="ConnectServer" IsEnabled="{Binding CanManage}" />
                <Button x:Name="CreateServerButton" Classes="primary" Content="{DynamicResource Ui.7410fc519703}" Click="NewServer" IsEnabled="{Binding CanManage}" />
              </StackPanel>
            </Grid>
            <Border Classes="card" IsVisible="{Binding NoServer}" Padding="36">
              <StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.7846930c4f25}" FontSize="23" FontWeight="SemiBold" /><TextBlock x:Name="EmptyServersHint" Text="{DynamicResource Ui.0eace834cc83}" Classes="muted" TextWrapping="Wrap" /><WrapPanel><Button Content="{DynamicResource Ui.c3a13e66b67a}" Classes="primary" Click="NewServer" IsEnabled="{Binding CanManage}" Margin="0,0,8,0" /><Button Content="{DynamicResource Ui.a80faf939cff}" Click="ConnectServer" IsEnabled="{Binding CanManage}" /></WrapPanel></StackPanel>
            </Border>
            <ListBox x:Name="ServersList" Classes="servers" ItemsSource="{Binding ServerRows}" SelectedItem="{Binding SelectedRow}" SelectionChanged="ServerRowSelected" IsVisible="{Binding HasServer}" Background="Transparent" BorderThickness="0" MaxHeight="250" IsEnabled="{Binding CanManage}">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="12,10">
                <StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" ToolTip.Tip="{Binding Path}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Metrics}" Classes="muted" FontSize="12" /></StackPanel>
                <Border Grid.Column="1" Classes="status-chip" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding StatusIcon}" /><TextBlock Text="{Binding Status}" /></StackPanel></Border>
              </Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="card" IsVisible="{Binding HasServer}">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{DynamicResource Ui.d441a8c4efe6}" Classes="eyebrow" /><TextBlock Text="{Binding ServerName}" FontSize="23" FontWeight="SemiBold" /></StackPanel><Border Grid.Column="1" Classes="status-chip" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding StatusChipIcon}" /><TextBlock Text="{Binding StatusChipText}" /></StackPanel></Border></Grid>
                <WrapPanel><Button x:Name="StartButton" Classes="primary" Content="{DynamicResource Ui.7b7da6f8ab38}" Click="StartServer" IsEnabled="{Binding CanStart}" IsVisible="{Binding ShowStart}" Margin="0,0,8,8" /><Button x:Name="StopButton" Classes="primary" Content="{DynamicResource Ui.cae7d57bc067}" Click="StopServer" IsEnabled="{Binding CanStop}" IsVisible="{Binding ShowStop}" Margin="0,0,8,8" /><Button x:Name="RestartButton" Content="{DynamicResource Ui.6b983a81e5e8}" Click="RestartServer" IsEnabled="{Binding CanRestart}" Margin="0,0,8,8" /><Button x:Name="BackupNowButton" Content="{DynamicResource Ui.02a2840b598b}" Click="CreateBackup" IsEnabled="{Binding CanAct}" Margin="0,0,8,8" /><Button x:Name="EditServerButton" Content="{DynamicResource Ui.3e8fb11efc9e}" Click="GoServerSettings" IsEnabled="{Binding HasServer}" Margin="0,0,8,8" /></WrapPanel>
                <TextBlock Text="{Binding StartHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><Button x:Name="StartPrerequisiteButton" Content="{Binding StartHelpText}" Click="GoStartPrerequisite" IsVisible="{Binding !CanStart}" HorizontalAlignment="Left" Padding="12,6" />
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                  <StackPanel Spacing="6"><TextBlock Text="{DynamicResource Ui.a1e4b72d1fe8}" Classes="eyebrow" /><TextBlock Text="{Binding Players}" FontSize="24" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.db9a4c7d4c19}" Classes="eyebrow" /><TextBlock Text="{Binding Cpu}" FontSize="24" /></StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6"><TextBlock Text="{DynamicResource Ui.a266fe9c4d1d}" Classes="eyebrow" /><TextBlock Text="{Binding Memory}" FontSize="24" /></StackPanel>
                  <StackPanel Grid.Column="3" Spacing="6"><TextBlock Text="{DynamicResource Ui.4cafea661228}" Classes="eyebrow" /><TextBlock Text="{Binding Uptime}" FontSize="24" /></StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}" />
                <TextBlock Text="{Binding BackupSummary}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Text="{Binding BuildSummary}" Classes="muted" TextWrapping="Wrap" />
                <Expander Header="Backups, game updates &amp; automation"><StackPanel Spacing="10"><WrapPanel><Button Content="{DynamicResource Ui.3334fee2c77f}" Click="GoBackups" Margin="0,0,8,8" /><Button Content="{DynamicResource Ui.d909750b1bbb}" Click="GoAutomation" Margin="0,0,8,8" /><Button Content="{DynamicResource Ui.ad1c87e7daa6}" Click="CheckUpdates" IsEnabled="{Binding CanAct}" Margin="0,0,8,8" /><Button x:Name="ApplyGameUpdateButton" Content="{DynamicResource Ui.c9b65aa957b7}" Click="ApplyUpdate" IsEnabled="{Binding CanUpdate}" Margin="0,0,0,8" /></WrapPanel><Button Content="{Binding UpdateHelpText}" Click="GoUpdatePrerequisite" IsVisible="{Binding !CanUpdate}" HorizontalAlignment="Left" /></StackPanel></Expander>
                <TextBlock Text="{Binding UpdateHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding AutomationSummary}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="{DynamicResource Ui.8f06f076d540}" Classes="muted" FontSize="12" IsVisible="{Binding HasServer}" />
          </StackPanel>
          <StackPanel x:Name="ServerSettingsPage" IsVisible="False" Spacing="18">
            <Button Content="{DynamicResource Ui.dea3ed7efb4e}" Click="GoServers" HorizontalAlignment="Left" />
            <TextBlock Text="{DynamicResource Ui.93ac4aebd5d0}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding NoServer}" />
            <StackPanel IsVisible="{Binding HasServer}" Spacing="18">
              <Button Content="{DynamicResource Ui.85b7eac64dc6}" Click="GoAutomation" HorizontalAlignment="Left" />
            <Border Classes="card"><StackPanel Spacing="16">
              <TextBlock Text="{DynamicResource Ui.6f39207b9650}" Classes="section" />
              <TextBlock Text="{DynamicResource Ui.2cd2ff9fbd16}" /><TextBox x:Name="ProfileName" /><TextBlock x:Name="ConnectionValidationError" Classes="field-error" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock Text="{DynamicResource Ui.adb878c9b0be}" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="InstallFolder" IsReadOnly="True" TextWrapping="Wrap" ToolTip.Tip="{Binding ServerPath}" /><Button x:Name="CopyInstallPathButton" Grid.Column="1" Content="{DynamicResource Ui.720ff4160412}" Click="CopyInstallPath" /></Grid>
              <TextBlock Text="{DynamicResource Ui.5d28873b6527}" />
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="DataFolder" IsReadOnly="True" TextWrapping="Wrap" /><Button Grid.Column="1" Content="{DynamicResource Ui.6a9084025c4b}" Click="OpenDataFolder" /></Grid><Button x:Name="CopySavedPathButton" Content="{DynamicResource Ui.688d0d5e8a9a}" Click="CopySavedPath" HorizontalAlignment="Left" />
              <TextBlock Text="{DynamicResource Ui.fb2647f443e8}" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="BackupFolder" /><Button Grid.Column="1" Content="{DynamicResource Ui.93c6b664dce6}" Click="BrowseBackups" /></Grid><TextBlock x:Name="BackupFolderValidationError" Classes="field-error" TextWrapping="Wrap" IsVisible="False" />
              <Button Content="{DynamicResource Ui.df24ef128adf}" x:Name="SaveConnectionButton" Classes="primary" Click="SaveConnection" IsEnabled="{Binding CanAct}" HorizontalAlignment="Left" />
              <Border Height="1" Background="{DynamicResource LineBrush}" /><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.1f280fc17b55}" Classes="section" /><TextBlock Text="{DynamicResource Ui.a0cfd16df1e7}" Classes="muted" TextWrapping="Wrap" /><Button x:Name="RemoveServerButton" Content="{DynamicResource Ui.8656022c4ffe}" Classes="subtle" Click="DisconnectServer" IsEnabled="{Binding CanAct}" HorizontalAlignment="Left" /></StackPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.748837ff0cd2}" Classes="section" /><TextBlock Text="{Binding ConfigurationHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="14"><StackPanel Spacing="6"><TextBlock Text="{DynamicResource Ui.98cc9ccb5360}" /><TextBox x:Name="OwnerId" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.0028647e0e6b}" /><TextBox x:Name="GameServerName" /></StackPanel><StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.5ded8dd44eba}" /><TextBox x:Name="WorldName" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.9e9efafb8321}" /><NumericUpDown x:Name="GamePort" Value="7777" Minimum="1024" Maximum="65535" FormatString="0" /></StackPanel><StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="{DynamicResource Ui.f1514ea58419}" /><TextBox x:Name="AdminPassword" PasswordChar="●" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.d7531e20956e}" /><TextBox x:Name="WorldPassword" PasswordChar="●" /></StackPanel></Grid><TextBlock x:Name="ConfigurationValidationError" Classes="field-error" TextWrapping="Wrap" IsVisible="False" /><Button x:Name="SaveGameConfigurationButton" Content="{DynamicResource Ui.dadf9b7de7be}" Click="WriteConfiguration" IsEnabled="{Binding CanConfigure}" HorizontalAlignment="Left" /></StackPanel></Border>
            </StackPanel>
          </StackPanel>
          <StackPanel x:Name="ResourcesPage" IsVisible="False" Spacing="20">
            <TextBlock Text="{Binding ResourcesHint}" Classes="muted" TextWrapping="Wrap" />
            <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.54aac653f06e}" Classes="section" /><TextBlock x:Name="CpuMetricText" Grid.Column="1" Text="{Binding Cpu}" Foreground="{DynamicResource NavSelectedTextBrush}" /></Grid><Grid><local:Sparkline x:Name="CpuChart" Height="180" /><TextBlock Text="{Binding ResourcesHint}" IsVisible="{Binding ShowResourceEmpty}" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="muted" /></Grid><TextBlock Text="{DynamicResource Ui.9ac1528d595a}" Classes="muted" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.c3963aedaac6}" Classes="section" /><TextBlock x:Name="MemoryMetricText" Grid.Column="1" Text="{Binding Memory}" Foreground="{DynamicResource WorkspaceStatusBrush}" /></Grid><local:Sparkline x:Name="MemoryChart" Height="180" /><TextBlock Text="{DynamicResource Ui.3b3d6e0b65d6}" Classes="muted" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.1dcf29ed97fc}" /><TextBlock Grid.Column="1" Text="{Binding DiskFree}" FontWeight="SemiBold" /></Grid></Border>
          </StackPanel>
          <StackPanel x:Name="AutomationPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="{DynamicResource Ui.1b61d4a1f83e}" Classes="section" /><ToggleSwitch x:Name="AutoUpdate" Content="{DynamicResource Ui.25ae08c97c51}" /><TextBlock Text="{DynamicResource Ui.932d797f2c96}" Classes="muted" TextWrapping="Wrap" /><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource Ui.c9fb0897ad8e}" /><NumericUpDown x:Name="UpdateInterval" Minimum="30" Increment="30" Maximum="10080" Value="60" FormatString="0" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{DynamicResource Ui.9625086a3d4f}" /><TextBlock Text="{Binding NextUpdate}" Classes="muted" Margin="0,10,0,0" /></StackPanel></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="18"><ToggleSwitch x:Name="UseWindow" Content="{DynamicResource Ui.e44f2073c9e7}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource Ui.4ff8e97999bd}" /><TextBox x:Name="WindowStart" Text="03:00" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{DynamicResource Ui.49e32ed47e8f}" /><TextBox x:Name="WindowEnd" Text="05:00" /></StackPanel></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="{DynamicResource Ui.2c1320018844}" Classes="section" /><ToggleSwitch x:Name="AutoBackup" Content="{DynamicResource Ui.c9174622fd12}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource Ui.c8de48b08445}" /><NumericUpDown x:Name="BackupInterval" Minimum="1" Maximum="720" Value="6" FormatString="0" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{DynamicResource Ui.470967250471}" /><NumericUpDown x:Name="Retention" Minimum="1" Maximum="1000" Value="20" FormatString="0" /></StackPanel></Grid><TextBlock Text="{Binding NextBackup}" Classes="muted" /></StackPanel></Border>
            <TextBlock Text="{DynamicResource Ui.d0dd93a5b58d}" Classes="muted" TextWrapping="Wrap" /><TextBlock x:Name="AutomationValidationError" Classes="field-error" IsVisible="False" TextWrapping="Wrap" />
            <Button Classes="primary" Content="{DynamicResource Ui.7a7199c92c5a}" Click="SaveAutomation" IsEnabled="{Binding CanAct}" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel x:Name="BackupsPage" IsVisible="False" Spacing="18">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.370c6e73d6f3}" Classes="section" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"><Button Classes="subtle" Content="{DynamicResource Ui.6a9084025c4b}" Click="OpenBackupFolder" IsEnabled="{Binding HasServer}" /><Button Classes="primary" Content="{DynamicResource Ui.02a2840b598b}" Click="CreateBackup" IsEnabled="{Binding CanAct}" /></StackPanel></Grid>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.03b28fa07a51}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.dffd71e2a9ba}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card" IsVisible="{Binding RecoveryPending}"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.ee9ce5741dd7}" Classes="section" /><TextBlock Text="{Binding RecoveryHint}" Classes="muted" TextWrapping="Wrap" /><Button x:Name="RecoverRestoreButton" Classes="primary" Content="{DynamicResource Ui.96b601727c77}" Click="RecoverRestore" IsEnabled="{Binding CanRecover}" HorizontalAlignment="Left" /></StackPanel></Border><TextBlock Text="{Binding BackupSummary}" Classes="muted" />
            <Border Classes="card" IsVisible="{Binding NoBackups}"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.495daa646bda}" Classes="section" /><TextBlock Text="{DynamicResource Ui.bab2723b7a9b}" Classes="muted" TextWrapping="Wrap" /><Button x:Name="CreateFirstBackupButton" Content="{DynamicResource Ui.3a34a6ac581d}" Click="CreateBackup" IsEnabled="{Binding CanCreateFirstBackup}" HorizontalAlignment="Left" /></StackPanel></Border>
            <ListBox x:Name="BackupList" Classes="servers" ItemsSource="{Binding Backups}" Background="Transparent" MinHeight="160" MaxHeight="330" SelectionChanged="BackupSelected" IsVisible="{Binding !NoBackups}">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="6,10"><StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" /><TextBlock Text="{Binding Coverage}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Size}" Classes="muted" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Spacing="12" IsVisible="{Binding !NoBackups}"><WrapPanel><Button Content="{DynamicResource Ui.175c23c3b362}" Click="VerifyBackup" IsEnabled="{Binding CanVerifySelected}" Margin="0,0,10,0" /><Button Classes="subtle" Content="{DynamicResource Ui.83936755cbe8}" x:Name="RestoreBackupButton" Click="RestoreBackup" IsEnabled="{Binding CanRestoreSelected}" /></WrapPanel><TextBlock Text="{Binding RestoreHint}" Classes="muted" TextWrapping="Wrap" /><Button x:Name="RestorePrerequisiteButton" Content="{Binding RestoreHelpText}" Click="GoRestorePrerequisite" IsVisible="{Binding !CanRestoreSelected}" HorizontalAlignment="Left" /></StackPanel>
          </StackPanel>
          <StackPanel x:Name="ActivityPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{DynamicResource Ui.e3a5d3ab99e5}" Classes="section" /><Button Grid.Column="1" Content="{DynamicResource Ui.0e9161011702}" Click="RefreshServerLog" /></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBox x:Name="ServerLogFilter" PlaceholderText="{DynamicResource Ui.4c134cdac2a7}" TextChanged="FilterServerLog" /><ToggleSwitch Grid.Column="1" x:Name="LiveServerLog" Content="{DynamicResource Ui.c2d18090000a}" /></Grid><TextBlock Text="{DynamicResource Ui.ed49f44988f3}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><TextBox x:Name="ServerLogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="300" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.93bf535e8323}" Classes="section" /><ListBox ItemsSource="{Binding Operations}" Background="Transparent" MaxHeight="260" MinHeight="130"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="5" Margin="4,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.f03d7de80a21}" Classes="section" /><Button Grid.Column="1" Content="{DynamicResource Ui.e21f935f11d7}" Click="CopyActivity" Padding="12,4" /></Grid><TextBox Text="{Binding Activity}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="260" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.a4fe65264ef7}" Classes="section" /><ComboBox x:Name="LanguagePicker" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{DynamicResource Ui.838c26b99d4b}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><WrapPanel><Button Content="{DynamicResource Ui.9bfc2514cb50}" Click="ImportLanguage" Margin="0,0,8,0" /><Button Content="{DynamicResource Ui.0034898cf0cc}" Click="ExportLanguage" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.a3d04206b99c}" Classes="section" /><TextBlock x:Name="AgentStatusText" Text="{DynamicResource Ui.ee8f22a39a85}" Classes="muted" TextWrapping="Wrap" /><ToggleSwitch x:Name="KeepBackground" Content="{DynamicResource Ui.d32dbec92d72}" /><TextBlock Text="{DynamicResource Ui.ed3a52f54dcc}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.71d6df14efe7}" Classes="section" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.efb52e7172b7}" VerticalAlignment="Center" /><ComboBox x:Name="ThemePicker" Grid.Column="1" Width="170" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="{DynamicResource Ui.60acc53f13a5}" /><ComboBoxItem Content="{DynamicResource Ui.dbcd5e7bb7a0}" /><ComboBoxItem Content="{DynamicResource Ui.6725e7bbcd28}" /></ComboBox></Grid><ToggleSwitch x:Name="CloseToTray" Content="{DynamicResource Ui.916cf03597c1}" IsChecked="True" /><ToggleSwitch x:Name="ReduceMotion" Content="{DynamicResource Ui.297ef4c79b4b}" IsChecked="True" IsCheckedChanged="MotionChanged" /><TextBlock Text="{DynamicResource Ui.c12d62ac8052}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><ToggleSwitch x:Name="LaunchAtLogin" Content="{DynamicResource Ui.bdae957d9a32}" /><Button Content="{DynamicResource Ui.1ccfe084fd97}" Click="SaveDesktop" HorizontalAlignment="Left" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="HelpPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.1d051160c571}" Classes="section" /><TextBlock Text="{DynamicResource Ui.65617f397c03}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.6cef82f47be3}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.aa5136423f07}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><WrapPanel><Button Content="{DynamicResource Ui.43a0cfb0e395}" Click="OpenProject" Margin="0,0,8,8" /><Button Content="{DynamicResource Ui.c011d6097bfb}" Click="OpenLicense" Margin="0,0,8,8" /><Button Content="{DynamicResource Ui.8fadbc8de273}" Click="OpenNotices" Margin="0,0,0,8" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.86265f7817dc}" Classes="section" /><TextBlock Text="{DynamicResource Ui.f46d5701701c}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.5cdd698aa7d5}" Classes="muted" TextWrapping="Wrap" /><Button Content="{DynamicResource Ui.0a2bc817fd28}" Click="OpenGuide" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.204de4b6d5a3}" Classes="section" /><TextBlock Text="{DynamicResource Ui.9f0797d9ac20}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.5035a67e6d78}" Classes="muted" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.268f14bbfe11}" Classes="section" /><Button Grid.Column="1" Content="{DynamicResource Ui.0e9161011702}" Click="RefreshDiagnostics" Padding="12,5" /></Grid><TextBlock Text="{Binding Diagnostics}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" TextWrapping="Wrap" /><Button Content="{DynamicResource Ui.2cdfcb6735e1}" Click="OpenServerLog" IsEnabled="{Binding HasServer}" HorizontalAlignment="Left" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="UpdatesPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.7b960b110c3c}" Classes="section" /><TextBlock x:Name="AppUpdateStatus" Text="{DynamicResource Ui.ed9b206f0860}" Classes="muted" TextWrapping="Wrap" /><WrapPanel><Button x:Name="CheckAppButton" Content="{DynamicResource Ui.9038973fff3d}" Click="CheckManagerUpdate" Margin="0,0,8,8" /><Button x:Name="DownloadAppButton" Content="{DynamicResource Ui.4f494b22379b}" Click="DownloadManagerUpdate" IsEnabled="False" Margin="0,0,8,8" /><Button x:Name="SwitchAppButton" Classes="primary" Content="{DynamicResource Ui.f5febf2142a2}" Click="SwitchManagerVersion" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel><TextBlock x:Name="AppUpdateHint" Classes="muted" TextWrapping="Wrap" /><TextBlock x:Name="AppUpdateTiming" Classes="muted" FontSize="12" TextWrapping="Wrap" /><ProgressBar x:Name="AppDownloadProgress" Minimum="0" Maximum="100" Height="5" /><Button x:Name="CancelAppDownloadButton" Content="{DynamicResource Ui.de5b23e69cd1}" Click="CancelManagerDownload" HorizontalAlignment="Left" /><TextBlock Text="{DynamicResource Ui.243c69de1890}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><Button Content="{DynamicResource Ui.b0c5045d6a7c}" Click="OpenManagerReleases" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{DynamicResource Ui.1254829bd999}" Classes="section" /><TextBlock x:Name="AppReleaseNotes" Text="{DynamicResource Ui.944b7ba7acff}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <StackPanel Grid.Row="3" Spacing="6" Margin="0,18,0,0"><TextBlock Text="{Binding LastCompletion}" IsVisible="{Binding HasLastCompletion}" Foreground="{DynamicResource WorkspaceStatusBrush}" FontSize="12" TextWrapping="Wrap" /><TextBlock x:Name="WorkspaceAnnouncement" Text="{Binding Notice}" AutomationProperties.Name="{Binding Announcement}" AutomationProperties.LiveSetting="Polite" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxHeight="60" /></StackPanel>
    </Grid>
  </Grid>
</Window>

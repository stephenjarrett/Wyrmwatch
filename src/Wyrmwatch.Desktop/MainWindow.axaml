<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Wyrmwatch.Desktop" x:Class="Wyrmwatch.Desktop.MainWindow"
        Title="Wyrmwatch · Dragonwilds server manager" Width="1240" Height="850" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="224,*">
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="16,28,16,20">
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="8,0,0,30">
          <Border Background="#8A78F0" CornerRadius="11" Width="38" Height="38"><TextBlock Text="W" FontSize="22" FontWeight="Bold" Foreground="#181321" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Wyrmwatch" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="DRAGONWILDS" Classes="eyebrow" FontSize="9" /></StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{DynamicResource Ui.5493ff8e9397}" Classes="eyebrow" Margin="14,0,0,12" />
        <ListBox Grid.Row="2" x:Name="Navigation" Classes="nav" SelectedIndex="0" SelectionChanged="Navigate">
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="◈" Width="18" /><TextBlock Text="{DynamicResource Ui.d4b1ea5708dd}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="⌁" Width="18" /><TextBlock Text="{DynamicResource Ui.e89b30aa1dc3}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="◷" Width="18" /><TextBlock Text="{DynamicResource Ui.d909750b1bbb}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="▣" Width="18" /><TextBlock Text="{DynamicResource Ui.3334fee2c77f}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="☷" Width="18" /><TextBlock Text="{DynamicResource Ui.38da1505ca83}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="⚙" Width="18" /><TextBlock Text="{DynamicResource Ui.74a883a037bc}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="?" Width="18" /><TextBlock Text="{DynamicResource Ui.b9ff3407124b}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="↗" Width="18" /><TextBlock Text="{DynamicResource Ui.66354a1d3225}" /></StackPanel></ListBoxItem>
          <ListBoxItem><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="↓" Width="18" /><TextBlock Text="{DynamicResource Ui.5808deaecd58}" /></StackPanel></ListBoxItem>
        </ListBox>
        <StackPanel Grid.Row="3" Spacing="12" Margin="8,0">
          <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,4" />
          <TextBlock Text="{DynamicResource Ui.1f799d61952d}" Foreground="#89C6A9" FontSize="12" />
          <TextBlock Text="{DynamicResource Ui.64d923c20eab}" Classes="muted" FontSize="11" />
          <TextBlock Text="{DynamicResource Ui.46e84d8edad0}" Classes="muted" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto" Margin="34,28,34,18">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,26">
        <StackPanel Spacing="6"><TextBlock Text="{Binding PageTitle}" Classes="heading" /><TextBlock Text="{Binding PageSubtitle}" Classes="muted" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Ui.6548864dfa03}" Classes="muted" FontSize="11" />
        <ComboBox Width="230" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" PlaceholderText="{DynamicResource Ui.5b428863326e}" SelectionChanged="ServerSelected">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <StackPanel x:Name="OverviewPage" Spacing="20">
            <Border Classes="card" Background="{DynamicResource HeroBrush}" Padding="28" IsVisible="{Binding NoServer}">
              <StackPanel Spacing="16">
                <TextBlock Text="{DynamicResource Ui.54a8093e2e9e}" FontSize="27" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Ui.7557b47aece0}" Classes="muted" TextWrapping="Wrap" MaxWidth="570" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0"><Button Classes="primary" Content="{DynamicResource Ui.c04b553dabce}" Click="ConnectServer" /><Button Classes="subtle" Content="{DynamicResource Ui.0a1a9b5c7897}" Click="NewServer" /></StackPanel>
                <TextBlock Text="{DynamicResource Ui.d7d571ce79a9}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="card" Background="{DynamicResource HeroBrush}" Padding="26" IsVisible="{Binding HasServer}">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource Ui.ff6bf422fac2}" Classes="eyebrow" /><TextBlock Text="{Binding ServerName}" FontSize="25" FontWeight="SemiBold" /></StackPanel><Border Grid.Column="1" CornerRadius="20" Background="#253F36" Padding="14,6" VerticalAlignment="Top"><TextBlock Text="{Binding Status}" Foreground="#A0E0BF" FontSize="12" /></Border></Grid>
                <TextBlock Text="{Binding ServerPath}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding CanAct}"><Button Classes="primary" Content="{DynamicResource Ui.7b7da6f8ab38}" Click="StartServer" /><Button Content="{DynamicResource Ui.02a2840b598b}" Click="CreateBackup" /><Button Classes="subtle" Content="{DynamicResource Ui.6b983a81e5e8}" Click="RestartServer" /><Button Classes="subtle" Content="{DynamicResource Ui.cae7d57bc067}" Click="StopServer" /></StackPanel>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
              <Border Classes="card" Padding="18"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.a1e4b72d1fe8}" Classes="eyebrow" /><TextBlock Text="{Binding Players}" FontSize="28" /><TextBlock Text="{DynamicResource Ui.0e31ab40ee72}" Classes="muted" FontSize="11" /></StackPanel></Border>
              <Border Grid.Column="1" Classes="card" Padding="18"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.db9a4c7d4c19}" Classes="eyebrow" /><TextBlock Text="{Binding Cpu}" FontSize="28" /><TextBlock Text="{DynamicResource Ui.61216600d64b}" Classes="muted" FontSize="11" /></StackPanel></Border>
              <Border Grid.Column="2" Classes="card" Padding="18"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.a266fe9c4d1d}" Classes="eyebrow" /><TextBlock Text="{Binding Memory}" FontSize="28" /><TextBlock Text="{DynamicResource Ui.0cd0da2bef6d}" Classes="muted" FontSize="11" /></StackPanel></Border>
              <Border Grid.Column="3" Classes="card" Padding="18"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.4cafea661228}" Classes="eyebrow" /><TextBlock Text="{Binding Uptime}" FontSize="28" /><TextBlock Text="{DynamicResource Ui.f0a5af1078fa}" Classes="muted" FontSize="11" /></StackPanel></Border>
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{DynamicResource Ui.d008fa29fa0a}" Classes="section" /><TextBlock Text="{DynamicResource Ui.01876774cefe}" Classes="muted" TextWrapping="Wrap" MinHeight="64" /><TextBlock Text="{Binding BackupSummary}" FontSize="12" /><Button Content="{DynamicResource Ui.c62a72e81eb8}" Click="GoBackups" HorizontalAlignment="Left" /></StackPanel></Border>
              <Border Grid.Column="1" Classes="card"><StackPanel Spacing="14"><TextBlock Text="{DynamicResource Ui.7107be855d10}" Classes="section" /><TextBlock Text="{DynamicResource Ui.32088b845e0e}" Classes="muted" TextWrapping="Wrap" MinHeight="64" /><TextBlock Text="{Binding BuildSummary}" FontSize="12" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanAct}"><Button Content="{DynamicResource Ui.2e6f94a6f87f}" Click="CheckUpdates" /><Button Classes="subtle" Content="{DynamicResource Ui.315d3ecbc1e1}" Click="ApplyUpdate" /></StackPanel></StackPanel></Border>
            </Grid>
            <Border Classes="card" Padding="18"><Grid ColumnDefinitions="Auto,*"><TextBlock Text="●" Foreground="#8A78F0" Margin="0,0,12,0" /><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding AutomationSummary}" FontWeight="Medium" /><TextBlock Text="{DynamicResource Ui.56236eaee0e4}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></Grid></Border>
          </StackPanel>
          <StackPanel x:Name="ResourcesPage" IsVisible="False" Spacing="20">
            <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.54aac653f06e}" Classes="section" /><TextBlock Grid.Column="1" Text="{Binding Cpu}" Foreground="#AF9EFF" /></Grid><local:Sparkline x:Name="CpuChart" Height="180" /><TextBlock Text="{DynamicResource Ui.9ac1528d595a}" Classes="muted" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.c3963aedaac6}" Classes="section" /><TextBlock Grid.Column="1" Text="{Binding Memory}" Foreground="#88C8AD" /></Grid><local:Sparkline x:Name="MemoryChart" Height="180" /><TextBlock Text="{DynamicResource Ui.3b3d6e0b65d6}" Classes="muted" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.1dcf29ed97fc}" /><TextBlock Grid.Column="1" Text="{Binding DiskFree}" FontWeight="SemiBold" /></Grid></Border>
          </StackPanel>
          <StackPanel x:Name="AutomationPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="{DynamicResource Ui.1b61d4a1f83e}" Classes="section" /><ToggleSwitch x:Name="AutoUpdate" Content="{DynamicResource Ui.25ae08c97c51}" /><TextBlock Text="{DynamicResource Ui.932d797f2c96}" Classes="muted" TextWrapping="Wrap" /><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource Ui.c9fb0897ad8e}" /><NumericUpDown x:Name="UpdateInterval" Minimum="5" Maximum="10080" Value="60" FormatString="0" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{DynamicResource Ui.9625086a3d4f}" /><TextBlock Text="{Binding NextUpdate}" Classes="muted" Margin="0,10,0,0" /></StackPanel></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="18"><ToggleSwitch x:Name="UseWindow" Content="{DynamicResource Ui.e44f2073c9e7}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource Ui.4ff8e97999bd}" /><TextBox x:Name="WindowStart" Text="03:00" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{DynamicResource Ui.49e32ed47e8f}" /><TextBox x:Name="WindowEnd" Text="05:00" /></StackPanel></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="18"><TextBlock Text="{DynamicResource Ui.2c1320018844}" Classes="section" /><ToggleSwitch x:Name="AutoBackup" Content="{DynamicResource Ui.c9174622fd12}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="8"><TextBlock Text="{DynamicResource Ui.c8de48b08445}" /><NumericUpDown x:Name="BackupInterval" Minimum="1" Maximum="720" Value="6" FormatString="0" /></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="{DynamicResource Ui.470967250471}" /><NumericUpDown x:Name="Retention" Minimum="1" Maximum="1000" Value="20" FormatString="0" /></StackPanel></Grid><TextBlock Text="{Binding NextBackup}" Classes="muted" /></StackPanel></Border>
            <Button Classes="primary" Content="{DynamicResource Ui.7a7199c92c5a}" Click="SaveAutomation" IsEnabled="{Binding CanAct}" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel x:Name="BackupsPage" IsVisible="False" Spacing="18">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.370c6e73d6f3}" Classes="section" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsEnabled="{Binding CanAct}"><Button Classes="subtle" Content="{DynamicResource Ui.6a9084025c4b}" Click="OpenBackupFolder" /><Button Classes="primary" Content="{DynamicResource Ui.02a2840b598b}" Click="CreateBackup" /></StackPanel></Grid>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.c0bca15f1609}" FontWeight="SemiBold" /><TextBlock Text="{DynamicResource Ui.8a2a7e81b3c4}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.02aa0617698c}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
            <TextBlock Text="{Binding BackupSummary}" Classes="muted" />
            <ListBox x:Name="BackupList" ItemsSource="{Binding Backups}" Background="Transparent" MinHeight="160" MaxHeight="330">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="6,10"><StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Size}" Classes="muted" VerticalAlignment="Center" /></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding CanAct}"><Button Content="{DynamicResource Ui.175c23c3b362}" Click="VerifyBackup" /><Button Classes="subtle" Content="{DynamicResource Ui.83936755cbe8}" Click="RestoreBackup" /></StackPanel>
          </StackPanel>
          <StackPanel x:Name="ActivityPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{DynamicResource Ui.e3a5d3ab99e5}" Classes="section" /><Button Grid.Column="1" Content="{DynamicResource Ui.0e9161011702}" Click="RefreshServerLog" /></Grid><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBox x:Name="ServerLogFilter" PlaceholderText="{DynamicResource Ui.4c134cdac2a7}" TextChanged="FilterServerLog" /><ToggleSwitch Grid.Column="1" x:Name="LiveServerLog" Content="{DynamicResource Ui.c2d18090000a}" /></Grid><TextBlock Text="{DynamicResource Ui.ed49f44988f3}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><TextBox x:Name="ServerLogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="300" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.93bf535e8323}" Classes="section" /><ListBox ItemsSource="{Binding Operations}" Background="Transparent" MaxHeight="260" MinHeight="130"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="5" Margin="4,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.f03d7de80a21}" Classes="section" /><Button Grid.Column="1" Content="{DynamicResource Ui.e21f935f11d7}" Click="CopyActivity" Padding="12,4" /></Grid><TextBox Text="{Binding Activity}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="260" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="SettingsPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.a4fe65264ef7}" Classes="section" /><ComboBox x:Name="LanguagePicker" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{DynamicResource Ui.838c26b99d4b}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><WrapPanel><Button Content="{DynamicResource Ui.9bfc2514cb50}" Click="ImportLanguage" Margin="0,0,8,0" /><Button Content="{DynamicResource Ui.0034898cf0cc}" Click="ExportLanguage" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.dc4bb4dc03b6}" Classes="section" /><ToggleSwitch x:Name="AutoAppChecks" Content="{DynamicResource Ui.395c09daa0fa}" /><TextBlock Text="{DynamicResource Ui.658b9f41c154}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.a3d04206b99c}" Classes="section" /><TextBlock x:Name="AgentStatusText" Text="{DynamicResource Ui.ee8f22a39a85}" Classes="muted" TextWrapping="Wrap" /><ToggleSwitch x:Name="KeepBackground" Content="{DynamicResource Ui.d32dbec92d72}" /><TextBlock Text="{DynamicResource Ui.ed3a52f54dcc}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.71d6df14efe7}" Classes="section" /><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="{DynamicResource Ui.efb52e7172b7}" /><TextBlock Text="{DynamicResource Ui.8533fd5a72b9}" Classes="muted" FontSize="12" /></StackPanel><ComboBox x:Name="ThemePicker" Grid.Column="1" Width="170" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="{DynamicResource Ui.60acc53f13a5}" /><ComboBoxItem Content="{DynamicResource Ui.dbcd5e7bb7a0}" /><ComboBoxItem Content="{DynamicResource Ui.6725e7bbcd28}" /></ComboBox></Grid><ToggleSwitch x:Name="CloseToTray" Content="{DynamicResource Ui.916cf03597c1}" IsChecked="True" /><ToggleSwitch x:Name="LaunchAtLogin" Content="{DynamicResource Ui.bdae957d9a32}" /><Button Content="{DynamicResource Ui.1ccfe084fd97}" Click="SaveDesktop" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.6f39207b9650}" Classes="section" /><Button Grid.Column="1" Content="{DynamicResource Ui.60a0676ce74d}" Click="ConnectServer" Padding="12,5" /></Grid><TextBlock Text="{DynamicResource Ui.e18e474ad076}" Classes="muted" FontSize="12" /><TextBox x:Name="ProfileName" PlaceholderText="{DynamicResource Ui.2b7f6a84de91}" /><TextBlock Text="{DynamicResource Ui.adb878c9b0be}" /><TextBox x:Name="InstallFolder" IsReadOnly="True" PlaceholderText="{DynamicResource Ui.f2e3ab1f11fb}" /><TextBlock Text="{DynamicResource Ui.5d28873b6527}" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="DataFolder" PlaceholderText="{DynamicResource Ui.c86c3af4f544}" /><Button Grid.Column="1" Content="{DynamicResource Ui.93c6b664dce6}" Click="BrowseData" /></Grid><TextBlock Text="{DynamicResource Ui.fb2647f443e8}" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox x:Name="BackupFolder" /><Button Grid.Column="1" Content="{DynamicResource Ui.93c6b664dce6}" Click="BrowseBackups" /></Grid><WrapPanel><Button Content="{DynamicResource Ui.df24ef128adf}" Click="SaveConnection" IsEnabled="{Binding CanAct}" Margin="0,0,8,0" /><Button Content="{DynamicResource Ui.8656022c4ffe}" Click="DisconnectServer" IsEnabled="{Binding CanAct}" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.748837ff0cd2}" Classes="section" /><TextBlock Text="{DynamicResource Ui.c511fb633d3c}" Classes="muted" FontSize="12" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="14"><StackPanel Spacing="6"><TextBlock Text="{DynamicResource Ui.98cc9ccb5360}" /><TextBox x:Name="OwnerId" /></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.21babfed6c38}" /><TextBox x:Name="GameServerName" /></StackPanel><StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.5ded8dd44eba}" /><TextBox x:Name="WorldName" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.9e9efafb8321}" /><NumericUpDown x:Name="GamePort" Value="7777" Minimum="1024" Maximum="65535" FormatString="0" /></StackPanel><StackPanel Grid.Row="2" Spacing="6"><TextBlock Text="{DynamicResource Ui.f1514ea58419}" /><TextBox x:Name="AdminPassword" PasswordChar="●" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="1" Spacing="6"><TextBlock Text="{DynamicResource Ui.d7531e20956e}" /><TextBox x:Name="WorldPassword" PasswordChar="●" /></StackPanel></Grid><Button Content="{DynamicResource Ui.dadf9b7de7be}" Click="WriteConfiguration" IsEnabled="{Binding CanAct}" HorizontalAlignment="Left" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="HelpPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{DynamicResource Ui.1d051160c571}" Classes="section" /><TextBlock Text="{DynamicResource Ui.65617f397c03}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.6cef82f47be3}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.aa5136423f07}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><WrapPanel><Button Content="{DynamicResource Ui.43a0cfb0e395}" Click="OpenProject" Margin="0,0,8,8" /><Button Content="{DynamicResource Ui.c011d6097bfb}" Click="OpenLicense" Margin="0,0,8,8" /><Button Content="{DynamicResource Ui.8fadbc8de273}" Click="OpenNotices" Margin="0,0,0,8" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.86265f7817dc}" Classes="section" /><TextBlock Text="{DynamicResource Ui.f46d5701701c}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.5cdd698aa7d5}" Classes="muted" TextWrapping="Wrap" /><Button Content="{DynamicResource Ui.0a2bc817fd28}" Click="OpenGuide" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.204de4b6d5a3}" Classes="section" /><TextBlock Text="{DynamicResource Ui.9f0797d9ac20}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{DynamicResource Ui.5035a67e6d78}" Classes="muted" FontSize="12" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{DynamicResource Ui.268f14bbfe11}" Classes="section" /><Button Grid.Column="1" Content="{DynamicResource Ui.0e9161011702}" Click="RefreshDiagnostics" Padding="12,5" /></Grid><TextBlock Text="{Binding Diagnostics}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" TextWrapping="Wrap" /><Button Content="{DynamicResource Ui.2cdfcb6735e1}" Click="OpenServerLog" IsEnabled="{Binding HasServer}" HorizontalAlignment="Left" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="RemotePage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{DynamicResource Ui.18b5247d4f3f}" Classes="section" /><TextBlock Text="{DynamicResource Ui.b0ecdaa023ff}" Classes="muted" TextWrapping="Wrap" /><ToggleSwitch x:Name="RemoteEnabled" Content="{DynamicResource Ui.d4c2690c0b66}" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="14"><NumericUpDown x:Name="RemotePort" Minimum="1024" Maximum="65535" Value="8843" FormatString="0" /><Button Grid.Column="1" Content="{DynamicResource Ui.46775a96667e}" Click="SaveRemote" /></Grid><TextBlock x:Name="RemoteAddressText" Text="{DynamicResource Ui.5feb4bc69803}" Classes="muted" TextWrapping="Wrap" /><TextBlock x:Name="CertificateText" Classes="muted" FontSize="12" TextWrapping="Wrap" /><WrapPanel><Button Content="{DynamicResource Ui.0e9161011702}" Click="RefreshRemote" Margin="0,0,8,0" /><Button Content="{DynamicResource Ui.3d8f49eddaf0}" Click="OpenRemote" Margin="0,0,8,0" /><Button Content="{DynamicResource Ui.316744d976d8}" Click="OpenCertificate" /></WrapPanel><TextBlock Text="{DynamicResource Ui.497be90ee1b4}" Classes="muted" FontSize="12" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{DynamicResource Ui.5450b2bec292}" Classes="section" /><TextBox x:Name="AccessName" PlaceholderText="{DynamicResource Ui.c9d06eb433bc}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="14"><ComboBox x:Name="AccessRole" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="{DynamicResource Ui.678bfa6af48b}" /><ComboBoxItem Content="{DynamicResource Ui.291101a07fe9}" /><ComboBoxItem Content="{DynamicResource Ui.57a69bb394dc}" /></ComboBox><NumericUpDown x:Name="AccessDays" Grid.Column="1" Minimum="1" Maximum="365" Value="30" FormatString="0" /></Grid><CheckBox x:Name="RestrictAccess" Content="{DynamicResource Ui.e69352511611}" IsChecked="True" /><TextBlock Text="{DynamicResource Ui.8cf85046d973}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><Button Content="{DynamicResource Ui.e418ef5096f5}" Click="CreateAccess" HorizontalAlignment="Left" /><TextBox x:Name="IssuedSecret" IsReadOnly="True" PlaceholderText="{DynamicResource Ui.6a637022e7cf}" /><Button Content="{DynamicResource Ui.e47c8bae740d}" Click="CopyAccess" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{DynamicResource Ui.e0277e0b5a78}" Classes="section" /><ListBox x:Name="AccessList" MinHeight="100" MaxHeight="260"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8" Spacing="5"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="{DynamicResource Ui.5311a627c995}" Click="RevokeAccess" HorizontalAlignment="Left" /></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="UpdatesPage" IsVisible="False" Spacing="18">
            <Border Classes="card"><StackPanel Spacing="16"><TextBlock Text="{DynamicResource Ui.7b960b110c3c}" Classes="section" /><TextBlock x:Name="AppUpdateStatus" Text="{DynamicResource Ui.ed9b206f0860}" Classes="muted" TextWrapping="Wrap" /><WrapPanel><Button Content="{DynamicResource Ui.9038973fff3d}" Click="CheckManagerUpdate" Margin="0,0,8,8" /><Button x:Name="DownloadAppButton" Content="{DynamicResource Ui.4f494b22379b}" Click="DownloadManagerUpdate" IsEnabled="False" Margin="0,0,8,8" /><Button x:Name="SwitchAppButton" Classes="primary" Content="{DynamicResource Ui.f5febf2142a2}" Click="SwitchManagerVersion" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel><ProgressBar x:Name="AppDownloadProgress" Minimum="0" Maximum="100" Height="5" /><Button Content="{DynamicResource Ui.de5b23e69cd1}" Click="CancelManagerDownload" HorizontalAlignment="Left" /><TextBlock Text="{DynamicResource Ui.243c69de1890}" Classes="muted" FontSize="12" TextWrapping="Wrap" /><Button Content="{DynamicResource Ui.b0c5045d6a7c}" Click="OpenManagerReleases" HorizontalAlignment="Left" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="14"><TextBlock Text="{DynamicResource Ui.1254829bd999}" Classes="section" /><TextBlock x:Name="AppReleaseNotes" Text="{DynamicResource Ui.944b7ba7acff}" Classes="muted" TextWrapping="Wrap" /></StackPanel></Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Spacing="8" Margin="0,18,0,0"><ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="3" /><TextBlock Text="{Binding Notice}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxHeight="60" /></StackPanel>
    </Grid>
  </Grid>
</Window>
